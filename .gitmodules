	branch = master
[submodule "native/telegram-ios"]
	path = native/telegram-ios
	url = https://github.com/TelegramMessenger/Telegram-iOS.git
	branch = master

[submodule "vendor/telegram-web-k"]
	path = vendor/telegram-web-k
