	branch = master
[submodule "native/telegram-android"]
	path = native/telegram-android
	url = https://github.com/TelegramMessenger/Telegram-Android.git
	branch = master
[submodule "vendor/tgcalls"]
	path = vendor/tgcalls
	url = https://github.com/TelegramMessenger/tgcalls.git
	branch = master
[submodule "vendor/mtproto-engine"]
	path = vendor/mtproto-engine
